@startuml repository-pattern
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam nodesep 30
skinparam ranksep 25
top to bottom direction


class PlantAppManager {
  +plant_repo: PlantRepository
  +schedule_repo: CareScheduleRepository
  +log_repo: ActionLogRepository
  +user_repo: UserRepository
}


abstract class PlantRepository {
  {abstract} +save(plant: Plant): None
  {abstract} +get_by_id(plant_id: int): Plant | None
  {abstract} +find_all(): List[Plant]
  {abstract} +find_by_user(user_id: int): List[Plant]
  {abstract} +delete(plant_id: int): None
}


abstract class CareScheduleRepository {
  {abstract} +save(schedule: CareSchedule): None
  {abstract} +get_by_id(schedule_id: int): CareSchedule | None
  {abstract} +find_by_plant(plant_id: int): List[CareSchedule]
  {abstract} +find_by_plant_and_care_type(plant_id: int, care_type: str): CareSchedule | None
  {abstract} +delete(schedule_id: int): None
}


abstract class ActionLogRepository {
  {abstract} +save(log: ActionLog): None
  {abstract} +get_by_id(log_id: int): ActionLog | None
  {abstract} +find_by_plant(plant_id: int): List[ActionLog]
  {abstract} +delete(log_id: int): None
}

abstract class UserRepository {
  {abstract} +save(user: User): None
  {abstract} +get_by_id(user_id: int): User | None
  {abstract} +find_by_username(username: str): User | None
  {abstract} +delete(user_id: int): None
}

class InMemoryPlantRepository {
  -_store: dict
  -_next_id: int
}


class InMemoryCareScheduleRepository {
  -_store: dict
  -_next_id: int
}


class InMemoryActionLogRepository {
  -_store: dict
  -_next_id: int
}

class InMemoryUserRepository {
  -_store: dict
  -_next_id: int
}


class Plant {
  +id: int | None
  +user_id: int
  +name: str
  +species: str
  +location: str
  +created_at: str
}

class CareSchedule {
  +id: int | None
  +plant_id: int
  +care_type: str
  +interval_days: int
}


class ActionLog {
  +id: int | None
  +plant_id: int
  +care_type: str
  +performed_at: str
  +notes: str
}

' ── Dependency Inversion: Manager → abstract interfaces ──
PlantAppManager --> PlantRepository
PlantAppManager --> CareScheduleRepository
PlantAppManager --> ActionLogRepository
PlantAppManager --> UserRepository


' ── Implementations ─────────────────────────────────────
PlantRepository <|-- InMemoryPlantRepository
CareScheduleRepository <|-- InMemoryCareScheduleRepository
ActionLogRepository <|-- InMemoryActionLogRepository
UserRepository <|-- InMemoryUserRepository


' ── Repository returns domain models ─────────────────────
PlantRepository ..> Plant : returns
CareScheduleRepository ..> CareSchedule : returns
ActionLogRepository ..> ActionLog : returns
UserRepository ..> User : returns


@enduml