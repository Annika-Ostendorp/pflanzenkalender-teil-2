@startuml user_login
skinparam actorStyle awesome

actor "User (Website)" as User
participant "Plant App" as App
participant "AuthenticationService" as Service
database "UserRepository" as Repo

'Content-Type Überprüfung'
alt#red Content-Type Header ist kein JSON

    |||

    User -> App : POST /api/auth/login (mit falschem Header)
    activate App
    App --[#red]> User : 415 Unsupported Media Type\n{"error": "Content-Type must be 'application/json'."}
    deactivate App

    |||

else Request-Body ist ungültiges JSON

    |||

    User -> App : POST /api/auth/login (mit ungültigem Body)
    activate App
    App --[#red]> User : 400 Bad Request\n{"error": "Request body must be valid JSON."}
    deactivate App

|||

else JSON-Struktur ist valide

|||

    'Input Überprüfung --> Daten werden wieder per POST an Server geschickt & verarbeitet'
    alt#red Eingabedaten ungültig

        |||

        User -> App : POST /api/auth/login (Payload)
        activate App
        note right of App
            **Mögliche Validierungsfehler (400 Bad Request):**
            * username fehlt -> "Field 'username' is required."
            * username ist leer -> "Field 'username' must not be empty."
            * password fehlt -> "Field 'password' is required."
            * password ist leer -> "Field 'password' must not be empty."
        endnote
        App --[#red]> User : 400 Bad Request\n{"error": "..."}
        deactivate App

    |||

    'App stellt Anfrage an Repo, ob Username existiert'
    else Eingabedaten inhaltlich gültig

        |||

        User -> App : POST /api/auth/login (Payload)
        activate App

        'Prüfen von möglichen Duplikaten/ User abrufen'
        App -> Repo : get_by_username(username)
        activate Repo

        |||

        alt#red Username existiert nicht (gibt None zurück)
            Repo --> App : None
            deactivate Repo

            note over App
                Egal ob der Benutzername komplett erfunden oder nur das Passwort falsch war;
                das System antwortet dann immer gleich mit 401 Unauthorized. 
                Dadurch kann ein möglicher Angreifer unserer App nie herausfinden, welche Usernamen
                es in der Datenbank wirklich gibt.
            endnote  
    
            App --[#red]> User : 401 Unauthorized\n{"error": "Invalid username or password."}
            deactivate App

        |||

    'Username existiert -> Passwort prüfen'
    else Username gefunden (gibt User-Objekt zurück)
        Repo --> App : user
        deactivate Repo
        activate App 

        |||

        App -> Service : verify_password(user.password_hash, password)
        activate Service
        Service --> App : False / True
        deactivate Service

        |||

        alt#red Passwort ist falsch (False)
            App --[#red]> User : 401 Unauthorized\n{"error": "Invalid username or password."}
            deactivate App
        
        |||

        'Credentials korrekt -> JWT-Token generieren'
        else Passwort ist korrekt (True)

            |||

            App -> Service : create_token(user.id, username)
            activate Service

            alt#red Token-Generierung funktioniert nicht
                Service --> App : raises Exception
                App --[#red]> User : 503 Service Unavailable\n{"error": "Service Unavailable."}
            
            |||

            'Happy Path: Login erfolgreich'
            else Token erfolgreich erzeugt
                Service --> App : access_token
                deactivate Service

                App --[#green]> User : 200 OK\n{"access_token": "<JWT>"}
                deactivate App

                |||
            end
        end
    end
end
