@startuml get_plant_invalid_request
skinparam actorStyle awesome

actor "User (Website)" as User
participant "Plant App" as App
participant "AuthenticationService" as Service
database "PlantRepository" as Repo

|||

User -> App : GET /api/plants/<id>
activate App

alt#red Authorization Header fehlt
    'Geschützter Endpoint wird diesmal ohne JWT aufgerufen'
    App --[#red]> User : 401 Unauthorized\n{"error": "Authentication required."}

else Authorization Header vorhanden
    'Endpoint wird mit JWT aufgerufen'
    User -> App : Authorization : Bearer <token>

    'JWT auf Gültigkeit prüfen'
    App -> Service : verify_token(token)
    activate Service

    alt#red Token ungültig, malformed oder expired
        'Token ist nicht oder nicht mehr gültig -> kann also auch nicht zurückgegeben werden'
        Service -> App : None

        'Zugriff wird deshalb verweigert'
        App --[#red]> User : 401 Unauthorized\n{"error": "Invalid or expired token."}

    else Token gültig
        'Benutzer-ID wird wieder aus gültigem JWt gelesen'
        Service --> App : Payload mit sub = user_id
        deactivate Service

        |||

        'Pflanze anhand übergebener plant_id suchen'
        App -> Repo : find_by_id(plant_id)
        activate Repo

        'Repository gibt entweder Pflanze oder None zurück'
        Repo --> App : plant oder None
        deactivate Repo

        alt#red Pflanze existiert nicht
            'Keine Pflanze mit dieser ID gefunden'
            App --[#red]> User : 404 Not Found\n{"error": "Plant not found."}  

        else Pflanze gehört anderem User
            'Datenschutz-Prüfung schlägt fehl'
            App -> App : plant.user_id != user_id

            'Gleiche Antwort wie bei nicht vorhandener Pflanze -> Vermeidung von ID Enumeration'
            App --[#red]> User : 404 Not Found\n{"error": "Plant not found."}
            deactivate App
        end
    end
end

note over App
    **Ausnahmebedingung:**
    Sollte während der Verarbeitung der Daten ein unerwarteter Server-Fehler auftreten,
    dann antwortet das System mit:
    500 Internal Server Error\n{"error": "An unexpected error occurred. Please try again later."}
endnote

@enduml